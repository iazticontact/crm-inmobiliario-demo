        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const root = it.json || {};\n  const payload = (root && typeof root.body === 'object' && root.body !== null) ? root.body : root;\n  const receivedAt = new Date().toISOString();\n  const missingFields = [];\n  const str = (v) => typeof v === 'string' ? v.trim() : '';\n  const eventType = str(payload.eventType);\n  const source = str(payload.source);\n  const workspaceId = str(payload.workspaceId);\n  const entityId = str(payload.entityId);\n  const summary = str(payload.summary);\n  if (eventType !== 'assistant.task_created') missingFields.push('eventType');\n  if (source !== 'nowcrm') missingFields.push('source');\n  if (!workspaceId) missingFields.push('workspaceId');\n  if (!entityId) missingFields.push('entityId');\n  if (!summary) missingFields.push('summary');\n  if (missingFields.length > 0) {\n    out.push({ json: { isValid: false, error: 'invalid_payload', missingFields, receivedAt } });\n    continue;\n  }\n  const clientIdRaw = str(payload.clientId);\n  const clientNameRaw = str(payload.clientName);\n  const timestampRaw = str(payload.timestamp);\n  const clientId = clientIdRaw ? clientIdRaw : null;\n  const clientName = clientNameRaw ? clientNameRaw : null;\n  const timestamp = timestampRaw ? timestampRaw : receivedAt;\n  out.push({ json: {\n    isValid: true,\n    eventType,\n    source,\n    workspaceId,\n    entityId,\n    clientId,\n    clientName,\n    summary,\n    timestamp,\n    receivedAt,\n    message: `Nueva tarea creada desde NowLabs AI: ${summary}`\n  }});\n}\nreturn out;"
