# CRM Inmobiliario Demo — variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena los valores con los del cliente.
# NO commitees `.env.local`. Para producción, configurar en Vercel → Settings.
# Documentación completa: docs/ENVIRONMENT_VARIABLES.md
# -----------------------------------------------------------------------------

# --- Supabase (obligatorio) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=        # alternativa a publishable (legacy)
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Asistente IA / OpenAI (opcional; sin esta key los botones IA quedan off) -
OPENAI_API_KEY=
# NOWLABS_MODEL=gpt-4.1-mini          # nombre legacy de variable (aún leído por el código)
# OPENAI_MODEL=gpt-4.1-mini

# --- Meta WhatsApp Cloud API (opcional; sin esto el outbound es pending_config)
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
NOWCRM_WEBHOOK_SECRET=
# META_GRAPH_VERSION=v21.0

# --- n8n (opcional; sin N8N_BASE_URL los triggers responden 'simulated') ------
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
# N8N_DEFAULT_TIMEOUT_MS=8000
# N8N_LOG_TRIGGERS=0

# --- /api/agent/tool — server-to-server only (n8n -> CRM) ---------------------
# Required for /api/agent/tool. If missing in any environment the endpoint
# returns 503 endpoint_disabled. Generate with `openssl rand -base64 48`.
# Treat this like a password: store it in Proton Pass and rotate on suspicion.
AGENT_TOOL_SECRET=

# --- Assistant brain provider (CRM /assistant -> n8n Agent V2) ----------------
# The CRM assistant (/api/assistant/v2) routes through the n8n "CRM Agent V2"
# webhook by default. Set ASSISTANT_PROVIDER=openai (or v1/local) ONLY to roll
# back to the legacy in-process brain; default (unset) = n8n.
# ASSISTANT_PROVIDER=n8n
# Webhook of the active n8n Agent V2 workflow. If unset, falls back to
# N8N_BASE_URL + /webhook/crm-agent-v2. Server-side only — never NEXT_PUBLIC_.
N8N_ASSISTANT_V2_WEBHOOK_URL=
# Shared secret sent as `x-nowcrm-agent-secret`; must match the n8n env
# N8N_ASSISTANT_V2_SECRET (the workflow's "Check secret" node). A password.
N8N_ASSISTANT_V2_SECRET=

# --- Assistant cost/abuse guard (P13) -----------------------------------------
# Protección de coste: bloquea megaprompts y mensajes gigantes ANTES de llamar a
# n8n/OpenAI (no gasta tokens). Todos opcionales; valores por defecto seguros.
# Límite normal de UI (aviso + bloqueo de envío). Por defecto 2000.
# NEXT_PUBLIC_ASSISTANT_MAX_INPUT_CHARS=2000
# A partir de aquí se muestra el contador de caracteres. Por defecto 1700.
# NEXT_PUBLIC_ASSISTANT_WARN_AT_CHARS=1700
# Límite absoluto que valida el backend (rechaza por encima). Por defecto 2500.
# ASSISTANT_MAX_INPUT_CHARS=2500
# Historial enviado al agente: nº de mensajes y chars/mensaje. Control de tokens.
# ASSISTANT_MAX_HISTORY_MESSAGES=8
# ASSISTANT_MAX_HISTORY_CHARS_PER_MESSAGE=600
# Rate limit best-effort por usuario+workspace (mensajes/min). Por defecto 10.
# ASSISTANT_RATE_LIMIT_PER_MINUTE=10

# --- Autocompletado de ubicación (P17) ----------------------------------------
# El autocompletado de localidad/zona funciona SIEMPRE con empresa (workspace) + catálogo local.
# Para una experiencia tipo logística (sugerencias reales y amplias) configura un proveedor externo.
# Server-side only: la clave NUNCA se expone al navegador (la usa /api/locations/suggest).
# Proveedor: google | mapbox | geoapify | local (vacío/local = sin API externa). Por defecto local.
# LOCATION_PROVIDER=local
# País por defecto para filtrar sugerencias. Por defecto ES.
# LOCATION_COUNTRY=ES
# Pon 'false' para desactivar por completo la llamada al proveedor (deja empresa+local). Por defecto on.
# LOCATION_AUTOCOMPLETE_ENABLED=true
# Clave del proveedor elegido (SOLO una, según LOCATION_PROVIDER). No subir a Git.
# GOOGLE_PLACES_API_KEY=
# GEOAPIFY_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# --- Google Calendar OAuth (opcional) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Feature flags (opcional; cualquier valor distinto de 'false' = activado) -
# Defaults: todos ON. Pon 'false' para ocultar el módulo en este deploy.
# NEXT_PUBLIC_ENABLE_BILLING=true
# NEXT_PUBLIC_ENABLE_AUTOMATIONS=true
# NEXT_PUBLIC_ENABLE_INBOX=true
# NEXT_PUBLIC_ENABLE_ASSISTANT=true
# NEXT_PUBLIC_ENABLE_OPPORTUNITIES=true
# NEXT_PUBLIC_ENABLE_CALENDAR=true
# NEXT_PUBLIC_ENABLE_INSTAGRAM=true
# NEXT_PUBLIC_ENABLE_WHATSAPP=true
# NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# --- Dev only -----------------------------------------------------------------
# NEXT_PUBLIC_FORCE_OFFLINE_DEV=false
# NEXT_PUBLIC_SHOW_DEBUG_PANEL=false
