# NowCRM — variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena los valores con los del cliente.
# NO commitees `.env.local`. Para producción, configurar en Vercel → Settings.
# Documentación completa: docs/ENVIRONMENT_VARIABLES.md
# -----------------------------------------------------------------------------

# --- Supabase (obligatorio) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=        # alternativa a publishable (legacy)
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- NowLabs AI / OpenAI (opcional; sin esta key los botones IA quedan off) ---
OPENAI_API_KEY=
# NOWLABS_MODEL=gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1-mini

# --- Meta WhatsApp Cloud API (opcional; sin esto el outbound es pending_config)
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
NOWCRM_WEBHOOK_SECRET=
# META_GRAPH_VERSION=v21.0

# --- n8n (opcional; sin N8N_BASE_URL los triggers responden 'simulated') ------
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
# N8N_DEFAULT_TIMEOUT_MS=8000
# N8N_LOG_TRIGGERS=0

# --- Google Calendar OAuth (opcional) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Feature flags (opcional; cualquier valor distinto de 'false' = activado) -
# Defaults: todos ON. Pon 'false' para ocultar el módulo en este deploy.
# NEXT_PUBLIC_ENABLE_BILLING=true
# NEXT_PUBLIC_ENABLE_AUTOMATIONS=true
# NEXT_PUBLIC_ENABLE_INBOX=true
# NEXT_PUBLIC_ENABLE_ASSISTANT=true
# NEXT_PUBLIC_ENABLE_OPPORTUNITIES=true
# NEXT_PUBLIC_ENABLE_CALENDAR=true
# NEXT_PUBLIC_ENABLE_INSTAGRAM=true
# NEXT_PUBLIC_ENABLE_WHATSAPP=true
# NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# --- Dev only -----------------------------------------------------------------
# NEXT_PUBLIC_FORCE_OFFLINE_DEV=false
# NEXT_PUBLIC_SHOW_DEBUG_PANEL=false
